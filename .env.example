# -----------------------------------------------------------------------------
# Variables d'environnement — jamais commiter le fichier .env réel
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=GMAO
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
TZ=Africa/Abidjan

# PostgreSQL — Neon (production) : coller l'URL complète
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/gmao?sslmode=require
# DB_SSL=true
# DB_SYNC=false

# PostgreSQL local (Docker ou installation native)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gmao
DB_USER=gmao
DB_PASSWORD=gmao_app_2026
DB_SYNC=true
DB_SSL=false

# JWT — à remplacer par des secrets longs en production
JWT_ACCESS_SECRET=changer_ce_secret_access_gmao_tres_long_2026
JWT_REFRESH_SECRET=changer_ce_secret_refresh_gmao_tres_long_2026
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# Politique mot de passe et verrouillage
BCRYPT_COST=12
MAX_LOGIN_TENTATIVES=5
VERROUILLAGE_MINUTES=15

# Fichiers
UPLOAD_DIR=./uploads
UPLOAD_MAX_MO=8

# E-mail commandes fournisseurs (optionnel)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=manupro@usine.ci
# SMTP_SECURE=false
